---
interface Props {
  title: string;
  date: string;
  excerpt: string;
  tags: string[];
  href: string;
  readingTime: string;
}

const { title, date, excerpt, tags, href, readingTime } = Astro.props;

const formattedDate = new Date(date).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<article class="post-card rv">
  <div class="card-meta">
    <time datetime={date}>{formattedDate}</time>
    <span class="sep">·</span>
    <span class="reading-time">{readingTime}</span>
  </div>
  <h3>
    <a href={href}>{title}</a>
  </h3>
  <p class="card-excerpt">{excerpt}</p>
  {
    tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => <span class="card-tag">{tag}</span>)}
      </div>
    )
  }
</article>

<style>
  .post-card {
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }

  .post-card:first-child {
    border-top: 1px solid var(--border);
  }

  .card-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: .75rem;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    margin-bottom: 8px;
  }

  .card-meta .sep {
    color: var(--border-hover);
  }

  .card-meta .reading-time {
    font-family: var(--font-mono);
    font-size: .72rem;
    color: var(--muted);
  }

  .post-card h3 {
    margin-bottom: 6px;
  }

  .post-card h3 a {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: color .15s;
  }

  .post-card h3 a:hover {
    color: var(--accent);
  }

  .card-excerpt {
    font-size: .9rem;
    color: var(--muted);
    line-height: 1.6;
    margin-bottom: 10px;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .card-tag {
    font-family: var(--font-mono);
    font-size: .65rem;
    padding: 2px 8px;
    background: var(--chip);
    color: var(--muted);
    border-radius: 3px;
  }
</style>