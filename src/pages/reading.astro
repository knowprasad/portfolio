---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface ReadEntry {
  title: string;
  author?: string;
  status: 'reading' | 'finished' | 'queued' | 'read';
  note: string;
  href?: string;
  notesHref?: string;
  date?: string;
}

const books: ReadEntry[] = [
  { title: 'Designing Data-Intensive Applications', author: 'Martin Kleppmann', status: 'reading', note: 'Chapter 7 right now. The storage engine chapter rewired how I think about Postgres.', notesHref: '#' },
  { title: 'Crafting Interpreters', author: 'Robert Nystrom', status: 'finished', date: 'Jun 2026', note: 'The single-pass compiler chapter is worth the price of the whole book. Built a toy language as I went.', notesHref: '#' },
  { title: 'The Art of Doing Science and Engineering', author: 'Richard Hamming', status: 'queued', note: 'For the style of thinking, not the content. Queue position three, no apologies.' },
];

const papers: ReadEntry[] = [
  { title: 'Attention Is All You Need', author: 'Vaswani et al., 2017', status: 'finished', date: 'Apr 2026', note: "Read it late on purpose — worth waiting until the abstractions made sense first.", notesHref: '#' },
  { title: 'Retrieval-Augmented Generation for Knowledge-Intensive NLP Tasks', author: 'Lewis et al., 2020', status: 'finished', date: 'May 2026', note: "Read it while debugging Platewise's retrieval. The paper is calmer about RAG than reality is.", notesHref: '#' },
  { title: 'LoRA: Low-Rank Adaptation of Large Language Models', author: 'Hu et al., 2021', status: 'reading', note: 'Understanding how people fine-tune without paying for full fine-tuning. Relevant to where Merix v2 is heading.', notesHref: '#' },
];

const articles: ReadEntry[] = [
  { title: 'How to Do Great Work', author: 'Paul Graham', status: 'read', date: 'Jun 2026', note: 'Reread the section on working hard three times. The optimism is the point, not the advice.', href: '#' },
  { title: "95%-ile Isn't That Good", author: 'Dan Luu', status: 'read', date: 'May 2026', note: 'Reached the same conclusion from the other direction: 200 Codeforces problems in, most ceilings I hit were self-imposed.', href: '#' },
  { title: 'Sharding Postgres at Notion', author: 'Notion Engineering', status: 'read', date: 'Apr 2026', note: 'Read it while designing Merix\'s schema. Puts a healthy fear of "we\'ll migrate later" into you early.', href: '#' },
];
---
<BaseLayout title="Reading — Shubham" description="What Shubham is reading — books, papers, and articles with honest notes.">
  <Header />

  <main>
    <div class="page-head">
      <h1>Reading</h1>
      <p class="sub">Books, papers, and articles I'm working through — with honest, one-line notes. Public notes = learning in public.</p>
    </div>

    <section aria-labelledby="books-h">
      <h2 id="books-h">Bookshelf</h2>
      {books.map((b) => (
        <article class="entry rv">
          <div class="meta">
            <span class={`status ${b.status}`}>{b.status}</span>
            {b.date && <span class="date">{b.date}</span>}
          </div>
          <h3>
            {b.href ? <a href={b.href}>{b.title}</a> : b.title}
            {b.author && <span class="author"> — {b.author}</span>}
          </h3>
          <p>{b.note}{b.notesHref && <> <a href={b.notesHref} class="notes-link">notes &rarr;</a></>}</p>
        </article>
      ))}
    </section>

    <section aria-labelledby="papers-h">
      <h2 id="papers-h">Papershelf</h2>
      {papers.map((p) => (
        <article class="entry rv">
          <div class="meta">
            <span class={`status ${p.status}`}>{p.status}</span>
            {p.date && <span class="date">{p.date}</span>}
          </div>
          <h3>
            {p.href ? <a href={p.href}>{p.title}</a> : p.title}
            {p.author && <span class="author"> — {p.author}</span>}
          </h3>
          <p>{p.note}{p.notesHref && <> <a href={p.notesHref} class="notes-link">notes &rarr;</a></>}</p>
        </article>
      ))}
    </section>

    <section aria-labelledby="articles-h">
      <h2 id="articles-h">Articles</h2>
      {articles.map((a) => (
        <article class="entry rv">
          <div class="meta">
            <span class={`status ${a.status}`}>{a.status}</span>
            {a.date && <span class="date">{a.date}</span>}
          </div>
          <h3>
            {a.href ? <a href={a.href}>{a.title}</a> : a.title}
            {a.author && <span class="author"> — {a.author}</span>}
          </h3>
          <p>{a.note}{a.notesHref && <> <a href={a.notesHref} class="notes-link">notes &rarr;</a></>}</p>
        </article>
      ))}
    </section>
  </main>

  <Footer />
</BaseLayout>
<style>
  main { max-width: 760px; margin: 0 auto; padding: 48px 24px 0; }
  .page-head { margin-bottom: 36px; }
  .page-head h1 { font-size: clamp(1.5rem, 4vw, 2rem); font-weight: 700; color: var(--text); letter-spacing: -0.01em; margin-bottom: 8px; }
  .page-head .sub { color: var(--muted); font-size: .95rem; line-height: 1.6; }
  section { margin-bottom: 40px; }
  section h2 { font-size: .78rem; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); font-weight: 600; margin-bottom: 18px; padding-bottom: 10px; border-bottom: 1px solid var(--border); }
  .entry { padding: 16px 0; border-bottom: 1px solid var(--border); }
  .meta { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
  .status { font-family: var(--font-mono); font-size: .65rem; padding: 2px 8px; border-radius: 3px; text-transform: uppercase; letter-spacing: .05em; }
  .status.reading { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
  .status.finished { background: color-mix(in srgb, var(--accent2) 15%, transparent); color: var(--accent2); }
  .status.queued { background: var(--chip); color: var(--muted); }
  .status.read { background: var(--chip); color: var(--muted); }
  .date { font-family: var(--font-mono); font-size: .7rem; color: var(--muted); }
  .entry h3 { font-size: .95rem; font-weight: 600; color: var(--text); margin-bottom: 4px; }
  .entry h3 a { color: var(--text); text-decoration: none; transition: color .15s; }
  .entry h3 a:hover { color: var(--accent); }
  .author { font-weight: 400; color: var(--muted); }
  .entry p { color: var(--muted); font-size: .88rem; line-height: 1.6; }
  .notes-link { font-family: var(--font-mono); font-size: .75rem; color: var(--accent2); text-decoration: none; }
  .notes-link:hover { text-decoration: underline; }
</style>