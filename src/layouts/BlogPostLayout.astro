---
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  date: string;
  readingTime: string;
  tags: string[];
  prevPost?: { title: string; href: string } | null;
  nextPost?: { title: string; href: string } | null;
  ogImage?: string;
  structuredData?: Record<string, unknown>;
}

const {
  title,
  description,
  date,
  readingTime,
  tags,
  prevPost,
  nextPost,
  ogImage,
  structuredData,
} = Astro.props;
---

<BaseLayout title={`${title} — Shubham`} description={description} image={ogImage} ogType="article" structuredData={structuredData}>
  <Header />

  <main class="post-main">
    <article class="post-article">
      <header class="post-header">
        <h1>{title}</h1>
        <div class="post-meta">
          <time datetime={date}>{new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
          <span class="sep">·</span>
          <span>{readingTime}</span>
        </div>
        {
          tags.length > 0 && (
            <div class="post-tags">
              {tags.map((tag) => <a href="#" class="post-tag">{tag}</a>)}
            </div>
          )
        }
      </header>

      <div class="post-body">
        <slot />
      </div>

      <footer class="post-footer">
        <nav class="post-nav" aria-label="Adjacent posts">
          {
            prevPost ? (
              <a href={prevPost.href} class="post-nav-link prev" rel="prev">
                <span class="post-nav-label">← Previous</span>
                <span class="post-nav-title">{prevPost.title}</span>
              </a>
            ) : <div />
          }
          {
            nextPost ? (
              <a href={nextPost.href} class="post-nav-link next" rel="next">
                <span class="post-nav-label">Next →</span>
                <span class="post-nav-title">{nextPost.title}</span>
              </a>
            ) : <div />
          }
        </nav>
        <a href="/blog" class="back-link">← All posts</a>
      </footer>
    </article>
  </main>

  <Footer />
</BaseLayout>
<style>
  .post-main {
    max-width: 760px;
    margin: 0 auto;
    padding: 48px 24px 0;
  }

  .post-header {
    margin-bottom: 40px;
  }

  .post-header h1 {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    letter-spacing: -0.01em;
    margin-bottom: 12px;
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: .8rem;
    color: var(--muted);
    margin-bottom: 14px;
  }

  .post-meta .sep { color: var(--border-hover); }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .post-tag {
    font-family: var(--font-mono);
    font-size: .65rem;
    padding: 2px 8px;
    background: var(--chip);
    color: var(--muted);
    border-radius: 3px;
    text-decoration: none;
    transition: color .15s, background .15s;
  }

  .post-tag:hover { color: var(--accent2); background: var(--border); }

  .post-body {
    max-width: 65ch;
    font-size: 17px;
    line-height: 1.75;
    color: var(--text);
  }

  .post-body :global(h2) {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 2.2em;
    margin-bottom: .6em;
    line-height: 1.3;
  }

  .post-body :global(h3) {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 1.8em;
    margin-bottom: .5em;
    line-height: 1.3;
  }

  .post-body :global(p) { margin-bottom: 1.2em; }

  .post-body :global(ul),
  .post-body :global(ol) {
    margin-bottom: 1.2em;
    padding-left: 1.5em;
  }

  .post-body :global(li) { margin-bottom: .4em; }
  .post-body :global(li::marker) { color: var(--muted); }

  .post-body :global(a) {
    color: var(--accent2);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-body :global(a:hover) { color: var(--accent); }

  .post-body :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 16px;
    margin: 1.5em 0;
    color: var(--muted);
    font-style: italic;
  }

  .post-body :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2em 0;
  }

  .post-body :global(strong) { font-weight: 600; }

  .post-body :global(:not(pre) > code) {
    font-family: var(--font-mono);
    font-size: .88em;
    background: var(--chip);
    color: var(--accent2);
    padding: 1px 5px;
    border-radius: 3px;
  }

  .post-body :global(pre) {
    margin: 1.5em 0;
    border-radius: 8px;
    border: 1px solid var(--border);
    overflow-x: auto;
    font-size: .85rem;
    line-height: 1.6;
    background: var(--surface) !important;
  }

  .post-body :global(pre code) {
    font-family: var(--font-mono);
    display: block;
    padding: 18px 20px;
    background: none;
  }

  .post-footer {
    margin-top: 56px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 28px;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    padding: 12px 16px;
    border: 1px solid var(--border);
    border-radius: 8px;
    transition: border-color .15s, background .15s;
  }

  .post-nav-link:hover { border-color: var(--border-hover); background: var(--chip); }
  .post-nav-link.next { text-align: right; }

  .post-nav-label {
    font-family: var(--font-mono);
    font-size: .7rem;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: .05em;
  }

  .post-nav-title {
    font-size: .88rem;
    color: var(--text);
    font-weight: 500;
  }

  .post-nav-link:hover .post-nav-title { color: var(--accent); }

  .back-link {
    font-family: var(--font-mono);
    font-size: .82rem;
    color: var(--muted);
    text-decoration: none;
    transition: color .15s;
  }

  .back-link:hover { color: var(--accent); }

  @media (max-width: 768px) {
    .post-nav { grid-template-columns: 1fr; }
    .post-nav-link.next { text-align: left; }
  }
</style>