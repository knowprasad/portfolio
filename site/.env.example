# Server-only token; optional for higher GitHub request limits.
SITE_URL=https://knowprasad.me
GITHUB_TOKEN=
# Configure these only after choosing the public contact destination.
NEXT_PUBLIC_FORMSPREE_ID=
NEXT_PUBLIC_CONTACT_EMAIL=
# Read-only integration shared with Portfolio CMS only; source IDs live in src/data/notion-sources.json.
NOTION_TOKEN=
# Legacy Astro variable retained for reference; the Next.js adapter uses data-source IDs above.
NOTION_DATABASE_ID=
# Optional stable HTTPS PDF URL. Alternatively add public/resume.pdf or set Profile > Resume PDF in Notion.
RESUME_URL=

# Portfolio guestbook (server-only; no service-role key is needed).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
GOOGLE_AUTH_ENABLED=false

# Anonymous visitor counter. Generate a server-only random key; never NEXT_PUBLIC.
VISITOR_WRITE_KEY=
VISITOR_COUNT_ENABLED=false
