NOTION_TOKEN=your_notion_integration_secret
NOTION_DATABASE_ID=your_database_id

# Optional — override these if your Notion columns use different names.
# Defaults shown below (matches the task spec schema).
# Shubham's actual columns: published, post date (lowercase / different names).
NOTION_PROP_PUBLISHED=published
NOTION_PROP_DATE=post date
